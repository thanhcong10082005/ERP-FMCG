# Driver App — Environment Variables
# Copy file này thành .env rồi điều giá trị thực tế

# ── API Backend (Backend C# — ASP.NET Core .NET 8) ────────────
# backend trong Pack/erp-fmcg-backend-csharp chạy ở
#   http://localhost:5000 (Kestrel default). URL KHÔNG kèm hậu tố /api
#   vì apiClient tự chuẩn hoá (mọi call đã viết "/api/...").
VITE_API_URL=http://localhost:5000
